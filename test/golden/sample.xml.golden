mode XML

## format
1: delimiter"<?" tag"xml" attribute" version" equals"=" string""1.0"" attribute" encoding" equals"=" string""UTF-8"" delimiter"?>"
2: comment"<!-- A comment. -->"
3: delimiter"<" tag"project" attribute" name" equals"=" string""demo"" delimiter">"
4: text"  " delimiter"<" tag"target" attribute" name" equals"=" string""build"" attribute" depends" equals"=" string"'init'" delimiter">"
5: text"    " delimiter"<" tag"echo" attribute" message" equals"=" string""hello"" delimiter"/>"
6: text"    " delimiter"<!" tag"[CDATA[" cdata" raw <text> " tag"]]" delimiter">"
7: text"  " delimiter"</" tag"target" delimiter">"
8: text"  " delimiter"<" tag"target" attribute" name" equals"=" string""test""
9: attribute"      depends" equals"=" string""build""
10: attribute"      description" equals"=" string""run the tests"" delimiter">"
11: text"    " delimiter"<" tag"junit" attribute" fork" equals"=" string""true""
12: attribute"        haltonfailure" equals"=" string""yes""
13: attribute"    " delimiter"/>"
14: text"  " delimiter"</" tag"target" delimiter">"
15: delimiter"</" tag"project" delimiter">"

