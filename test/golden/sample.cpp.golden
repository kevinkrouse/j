mode C++

## format
1: preprocessor"#include" text" <" identifier"string" text">"
2:
3: identifier"namespace" text" " identifier"demo" text" " brace"{"
4:
5: keyword"class" text" " identifier"Widget" text" : " keyword"public" text" " identifier"Base" text" " brace"{"
6: keyword"public" text":"
7: text"    " identifier"explicit" text" " function"Widget" text"(" keyword"int" text" " identifier"n" text") : " function"n_" text"(" identifier"n" text") " brace"{}"
8: text"    " keyword"virtual" text" ~" function"Widget" text"();"
9: text"    " keyword"int" text" " function"size" text"() " keyword"const" text" " brace"{" text" " keyword"return" text" " identifier"n_" text" " operator"*" text" " number"0XA" text"; " brace"}"
10: keyword"private" text":"
11: text"    " keyword"int" text" " identifier"n_" text";  " comment"// count"
12: brace"}" text";"
13:
14: identifier"Widget" text"::~" function"Widget" text"()"
15: brace"{"
16: text"    " identifier"std" text"::" identifier"string" text" " identifier"s" text" " operator"=" text" " string""bye"" text";"
17: brace"}"
18:
19: brace"}"

