5: key"path" delimiter"=" value"/usr/local"
6: key"long " delimiter"=" value" first part \"
7: value"    second part"
8: key"cont " delimiter"=" value" value \"
9: value"# this starts with a marker but continues the value"
10: key"indented   " delimiter"=" value"   value with spaces"
11: key"escaped " delimiter"=" value" ends with double backslash \\"
12: key"literal " delimiter"=" value" "quoted" and don't apostrophe"

