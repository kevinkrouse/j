2: parenthesis"(" keyword"defpackage" text" " secondaryKeyword":demo" text" " parenthesis"(" secondaryKeyword":use" text" " secondaryKeyword":cl" parenthesis")" parenthesis")"
3:
4: parenthesis"(" keyword"defun" function" greet" text" " parenthesis"(" text"name" text" " secondaryKeyword"&optional" text" " parenthesis"(" text"n" text" " text"#" text"x1F" parenthesis")" parenthesis")"
5: text"  " string""Docstring.""
6: text"  " parenthesis"(" keyword"let" text" " parenthesis"(" parenthesis"(" text"s" text" " parenthesis"(" keyword"format" text" " text"nil" text" " string""Hello, ~A"" text" " text"name" parenthesis")" parenthesis")" parenthesis")"
7: text"    " parenthesis"(" keyword"when" text" " parenthesis"(" keyword">" text" " text"n" text" " text"0" parenthesis")"
8: text"      " parenthesis"(" keyword"print" text" " text"s" parenthesis")" parenthesis")"
9: text"    " comment"#| block"
10: comment"       comment |#"
11: text"    " text"s" parenthesis")" parenthesis")"
12:
13: parenthesis"(" keyword"defmacro" function" twice" text" " parenthesis"(" text"form" parenthesis")"
14: text"  " punctuation"`" parenthesis"(" keyword"progn" text" " punctuation"," substitution"form" text" " punctuation"," substitution"form" parenthesis")" parenthesis")"

