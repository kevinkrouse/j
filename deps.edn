;; Dependency manifest for the babashka/tools.build build (see build.clj).
;;
{:paths ["src"]

 ;; build.clj creates its basis with :root nil so that nothing but the deps
 ;; below lands on J's compile/run classpath, which means the repositories
 ;; have to be named here rather than inherited from the standard root.
 :mvn/repos
 {"central" {:url "https://repo1.maven.org/maven2/"}}

 ;; Empty on purpose. ABCL moved to extensions/abcl; core depends on
 ;; nothing but the JDK.
 :deps {}

 :aliases
 {;; extra deps needed to compile and run test/src
  :test
  {:extra-deps {org.junit.platform/junit-platform-console-standalone {:mvn/version "6.1.3"}}}

  ;; `bb lint`: on the annotation processor path, never the classpath
  :errorprone
  {:extra-deps {com.google.errorprone/error_prone_core {:mvn/version "2.50.0"}}}

  ;; `bb run-swingexplorer`
  :swingexplorer
  {:extra-deps {org.swingexplorer/swingexplorer-core {:mvn/version "1.7.0"}
                org.swingexplorer/swingexplorer-agent {:mvn/version "1.7.0"}
                javassist/javassist {:mvn/version "3.12.1.GA"}
                org.swinglabs/swing-layout {:mvn/version "1.0.3"}}}}}
